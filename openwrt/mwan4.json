{
  "check_interval_ms": 500,
  "probe_timeout_ms": 400,
  "window_size": 10,
  "loss_threshold_down": 0.5,
  "degrade_loss_threshold": 0.2,
  "degrade_hysteresis": 0.1,
  "degrade_exit_samples": 6,
  "degrade_enter_samples": 20,
  "degrade_min_out_samples": 20,
  "consecutive_fail_down": 3,
  "recovery_success_count": 5,
  "max_rtt_ms": 1500.0,
  "flush_conntrack_on_down": true,
  "flush_conntrack_on_switch": true,
  "route_priority": 0,
  "remove_routes_on_exit": false,
  "ecmp_mode": "auto",
  "_multipath_hash_policy_comment": "l3 / l4 / inner；预设 l4（按连线分散）。l3 会让同一个目的 IP 的连线全挤一条 WAN；null = 不写入内核",
  "multipath_hash_policy": "l4",
  "_capacity_proportional_comment": "每条 interface 都填 max_mbps 时，ECMP 权重自动 ∝ max_mbps",
  "_load_aware_comment": "true 时把利用率超过 load_target_ratio 的线权重下修、转到空闲线；启用时每条 interface 必填 max_mbps",
  "load_aware": false,
  "load_target_ratio": 0.8,
  "load_recover_ratio": 0.6,
  "allow_dynamic_weights_on_standard": false,
  "interfaces": [
    {
      "name": "wan1",
      "gateway": "192.168.1.1",
      "metric": 1,
      "weight": 1,
      "max_mbps": 1000,
      "up_mbps": 100,
      "probe_targets": [
        "223.5.5.5:53",
        "114.114.114.114:53"
      ]
    },
    {
      "name": "wan2",
      "gateway": "192.168.2.1",
      "metric": 1,
      "weight": 1,
      "max_mbps": 500,
      "up_mbps": 50,
      "probe_targets": [
        "223.5.5.5:53",
        "114.114.114.114:53"
      ]
    }
  ]
}
