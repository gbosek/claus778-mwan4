config global 'global'
	option enabled '0'
	# Must be strictly lower than the metrics of netifd-installed default
	# routes on participating WANs; start is refused on conflicts.
	option route_priority '0'
	option check_interval_ms '500'
	option probe_timeout_ms '400'
	option window_size '10'
	option loss_threshold_down '0.5'
	# 降级门槛/迟滞：窗口填满且丢包 >= 门槛即退出 ECMP（仍探测、恢复自动回归）；须 < loss_threshold_down，退出门槛 = 门槛 - 迟滞（须严格小于门槛，否则反复重下路由）
	# enter/exit/min_out_samples：进出降级与最短离开所需的连续样本数（预设 20 ≈ 2 窗口 / 6 ≈ 3 秒）；隧道满载探针偶超时故需持续才降级，设 1 = 旧行为
	option degrade_loss_threshold '0.2'
	option degrade_hysteresis '0.1'
	option degrade_exit_samples '6'
	option degrade_enter_samples '20'
	option degrade_min_out_samples '20'
	option consecutive_fail_down '3'
	option recovery_success_count '5'
	option max_rtt_ms '1500'
	option flush_conntrack '1'
	# 存活成员进出时是否清 conntrack（仅 standard ECMP 生效，主备模式只清新进成员）
	option flush_conntrack_on_switch '1'
	# 保留内核退出清理的保守默认值；OpenWrt service_stopped 会
	# 尝试从运行时快照恢复原有的 netifd IPv4/IPv6 默认路由。
	option remove_routes_on_exit '0'
	# standard: 单一 multipath 路由，成员/权重一变就重算整张 hash，实测连坐搬走 40%~43% 既有连线（换出口=换 NAT=断线），故非预设
	# resilient: 内核 nexthop group（Linux 5.14+），只重映射故障成员 bucket（默认延后 120 秒）；auto（预设）优先 resilient，否则退回 standard
	option ecmp_mode 'auto'
	# 多路径哈希策略（预设 l4）：l3 只哈希 IP → 同目的 IP 的连线全挤一条 WAN；l4 加端口 → 24 条连线变 12/12；inner 仅对封装流量有用
	# 实测 fib_multipath_hash_fields 写 1/7/8/9/31/32 都被内核忽略，真正有效的只有此 policy；空值 = 不碰内核设定（沿用系统预设）
	option multipath_hash_policy 'l4'
	# 负载感知分流：依实测速率 vs 每条 interface 容量下修过载线权重；启用时每条 interface 必须填 max_mbps，否则 check-config 拒绝
	# load_target_ratio / load_recover_ratio：利用率 >= 前者开始下修、<= 后者才完全恢复，中间为迟滞死区
	option load_aware '0'
	option load_target_ratio '0.80'
	option load_recover_ratio '0.60'
	# ECMP 权重模式：static（预设，固定 weight）/ quality（依实测丢包与 RTT 动态调整）
	# 动态因子（quality/load_aware）仅在 standard ECMP 下被忽略；auto 装 resilient 时直接生效，设 1 才在 standard 强行套用。dynamic_weight_interval_ms/min_ratio = 最小更新间隔与下修下限
	option allow_dynamic_weights_on_standard '0'
	option weight_mode 'static'
	option dynamic_weight_interval_ms '10000'
	option dynamic_weight_min_ratio '0.25'

# No interfaces are preconfigured. On first installation this package will
# NOT manage the default route; explicitly add WANs in LuCI and enable service.
# Example (commented; the user must select their own existing logical WAN):
# config interface 'uplink'
#     option enabled '1'
#     option network 'wan'
#     # option network6 'wan6'   # optional if IPv6 uses a separate logical iface
#     # option gateway6 'fe80::1' # normally discovered from netifd
#     option metric '10'
#     option weight '1'
#     list probe_targets '1.1.1.1:53'
#
# Legacy/manual mode still accepts option name 'ethX'. On PPPoE interfaces
# select option network instead of the underlying physical Ethernet device.

# 策略分流：匹配来源（可选目的）的流量走指定 WAN，其余仍走 ECMP；目标 WAN DOWN 时规则自动移除。可有多个 config policy 段。
# 例：#config policy 'guest' / list source '192.168.3.0/24' / list destination '10.0.0.0/8' / option interface 'wan2' / option priority '9000'
