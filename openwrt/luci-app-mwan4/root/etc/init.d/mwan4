#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/mwan4
CONF_DIR=/var/etc
CONF_FILE="$CONF_DIR/mwan4.json"
# Route snapshots are runtime-only. Never persist another router's gateways
# across reboots. Requires ip-full's binary "route save/restore" support.
ROUTE_SNAPSHOT_DIR=/var/run/mwan4-route-backup

# Snapshot current main-table defaults BEFORE the Rust daemon installs its
# own proto-77 default route. Existing snapshots survive daemon reloads.
snapshot_default_routes() {
	local family snap tmp
	mkdir -p "$ROUTE_SNAPSHOT_DIR" || return 1
	chmod 700 "$ROUTE_SNAPSHOT_DIR" || return 1
	for family in 4 6; do
		snap="$ROUTE_SNAPSHOT_DIR/default$family.bin"
		[ -e "$snap" ] && continue
		# IPv4-only OpenWrt kernels may not support any IPv6 route calls.
		[ "$family" = 6 ] && ! ip -6 route show table main >/dev/null 2>&1 && continue
		# A leftover mwan4 route is not an original netifd route. Refuse to
		# snapshot it, as restoring it would recreate stale ECMP nexthops.
		if ip "-$family" route show table main default proto 77 | grep -q .; then
			logger -t mwan4 "Skipping IPv$family snapshot: mwan4 route already present"
			continue
		fi
		tmp="$snap.tmp.$$"
		if ! ip "-$family" route save table main default > "$tmp"; then
			rm -f "$tmp"
			logger -t mwan4 "IPv$family default route snapshot failed (ip-full required)"
			return 1
		fi
		mv -f "$tmp" "$snap" || return 1
	done
}

# Fail safe if the new ECMP default metric collides with or ranks below
# a netifd default. We never replace a same-metric route owned by the OS,
# and a worse metric would leave mwan4 ineffectual while reporting "up".
# An IPv6 default is often metric 1024; the same rule applies per family.
verify_default_route_metric() {
	local managed_metric="$1" family rows
	for family in 4 6; do
		if [ "$family" = 6 ] && ! ip -6 route show table main >/dev/null 2>&1; then
			continue
		fi
		rows="$(ip "-$family" -o route show table main default)" || return 1
		[ -n "$rows" ] || continue
		if printf '%s\n' "$rows" | awk -v chosen="$managed_metric" '
		{
			metric=0; owned=0;
			for (i=1; i<=NF; i++) {
				if ($i=="metric" && i<NF) metric=$(i+1);
				if ($i=="proto" && i<NF && ($(i+1)=="77" || $(i+1)=="mwan4")) owned=1;
			}
			if (!owned && metric <= chosen) { print; failure=1; }
		}
		END { exit failure?0:1 }'; then
			logger -t mwan4 "IPv$family default route metric conflicts with mwan4 metric $managed_metric: configure existing WAN default route metrics higher, leaving networking untouched"
			return 1
		fi
	done
	return 0
}

# Called by rc.common after procd_kill has stopped the daemon.
# Only touch default routes identified as mwan4 proto-77. Do not flush
# main-table LAN routes, PBR tables, IP rules, or conntrack on service stop.
restore_default_routes() {
	local family snap size owned_routes previous_routes cleanup_failed
	for family in 4 6; do
		snap="$ROUTE_SNAPSHOT_DIR/default$family.bin"
		# Even without a saved original default, a user-requested stop
		# must clean up mwan4-owned routes. Do not touch non-owned routes.
		cleanup_failed=0
		while :; do
			owned_routes="$(ip "-$family" route show table main default proto 77 2>/dev/null)" || {
				logger -t mwan4 "IPv$family: could not inspect owned proto-77 route; leaving snapshot"
				cleanup_failed=1
				break
			}
			[ -n "$owned_routes" ] || break
			previous_routes="$owned_routes"
			if ! ip "-$family" route del table main default proto 77; then
				logger -t mwan4 "IPv$family: could not remove owned proto-77 route; leaving snapshot"
				cleanup_failed=1
				break
			fi
			owned_routes="$(ip "-$family" route show table main default proto 77 2>/dev/null)" || {
				logger -t mwan4 "IPv$family: could not verify proto-77 route cleanup; leaving snapshot"
				cleanup_failed=1
				break
			}
			if [ "$owned_routes" = "$previous_routes" ]; then
				logger -t mwan4 "IPv$family: proto-77 route remained after delete; leaving snapshot"
				cleanup_failed=1
				break
			fi
		done
		[ "$cleanup_failed" -eq 0 ] || continue
		[ -f "$snap" ] || continue
		size="$(wc -c < "$snap" 2>/dev/null)" || continue
		if [ "$size" -le 4 ]; then
			# The original route table did not contain a default.
			logger -t mwan4 "IPv$family had no original default; netifd owns recovery"
			rm -f "$snap"
			continue
		fi
		# Prefer CURRENT netifd state. A saved DHCP/PPPoE gateway may be
		# obsolete after a renew or redial and must not be replayed.
		if ip "-$family" route show table main default | grep -q .; then
			logger -t mwan4 "IPv$family current default exists; discarding older snapshot"
			rm -f "$snap"
		elif ip "-$family" route restore < "$snap"; then
			logger -t mwan4 "IPv$family emergency route snapshot restored"
			rm -f "$snap"
		else
			logger -t mwan4 "IPv$family restore failed; check current netifd state; keeping snapshot"
		fi
	done
	rmdir "$ROUTE_SNAPSHOT_DIR" 2>/dev/null || :
}

service_stopped() {
	# SIGKILL cannot run Rust's shutdown cleanup. Clear only adapter rules
	# carrying our protocol marker in our reserved band; never flush PBR's
	# standalone rules. Keep nft chains so existing PBR goto targets stay valid.
	if [ -f "$CONF_DIR/mwan4-pbr.json" ]; then
		local priorities priority
		priorities="$(ip -4 rule show protocol 77 2>/dev/null | awk -F: '$1>=8000 && $1<8126 {print $1}')"
		for priority in $priorities; do
			ip -4 rule del pref "$priority" protocol 77 || logger -t mwan4 "Could not remove adapter rule $priority"
		done
	fi
	restore_default_routes
}

service_started() {
	local pbr_mode
	config_get pbr_mode global pbr_mode standalone
	if [ "$pbr_mode" = mossdef ] && [ -x /etc/init.d/pbr ]; then
		# PBR starts earlier at boot. Publish consumer chains/manifest first,
		# then ask enabled PBR to resolve its targets against the new mapping.
		(/etc/init.d/pbr reload > "$CONF_DIR/mwan4-pbr/reload.log" 2>&1) &
	fi
}

# rc.common's default procd reload calls start_service() directly; it does
# NOT call service_stopped(). With changing PPPoE netdevs that may leave
# a stale proto-77 route if the new configuration has zero active WANs.
# The lock is already held by rc.common's reload() wrapper. Do not call
# /etc/init.d/mwan4 stop/restart here (that would recurse on procd_lock).
reload_service() {
	local base="${basescript:-$initscript}" daemon
	daemon="${base##*/}"
	procd_kill "$daemon"
	service_stopped
	rc_procd start_service
}


# UCI 值直接拼进 JSON，有写入权限者（rpcd ACL 开放）可用引号/反斜线/换行注入栏位，故字串一律转义、数字一律先验证
json_escape() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr -d '\r\n'
}

is_uint() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
		0) return 0 ;;
		0*) return 1 ;;
	esac
	return 0
}

# 只接受 JSON 合法十进位小数（拒 .5 / 1. / 1.2.3 / 007 / 10%）
is_decimal() {
	case "$1" in
		''|*[!0-9.]*) return 1 ;;
		.*|*.) return 1 ;;
		*.*.*) return 1 ;;
		0) return 0 ;;
		0.*) return 0 ;;
		0*) return 1 ;;
	esac
	return 0
}

generate_json_config() {
	mkdir -p "$CONF_DIR"

	local enabled check_interval probe_timeout window_size loss_down degrade_loss degrade_hysteresis degrade_exit degrade_enter degrade_min_out fail_down recovery max_rtt flush_ct flush_switch ecmp_mode remove_routes dyn_standard_ok route_priority
	# 未设定即视为启用（与 LuCI 预设一致，也让忘记写 enabled 不会静默不启动）
	config_get_bool enabled global enabled 0
	[ "$enabled" -eq 1 ] || return 1

	config_get check_interval global check_interval_ms 500
	# 探测超时必须 <= 探测周期，否则实际周期会被超时拖长
	config_get probe_timeout global probe_timeout_ms 400
	config_get window_size global window_size 10
	config_get loss_down global loss_threshold_down 0.5
	# 降级门槛/迟滞：窗口填满且丢包 >= 此值即退出 ECMP（仍探测）；须 < loss_threshold_down，且迟滞严格小于门槛，否则 check-config 拒绝
	# enter/exit/min_out_samples：进出降级与最短离开所需的连续样本数（预设 20 ≈ 2 窗口 / 6 ≈ 3 秒）；需持续才降级以免隧道满载探针偶超时误判，设 1 = 旧行为
	config_get degrade_loss global degrade_loss_threshold 0.2
	config_get degrade_hysteresis global degrade_hysteresis 0.1
	config_get degrade_exit global degrade_exit_samples 6
	config_get degrade_enter global degrade_enter_samples 20
	config_get degrade_min_out global degrade_min_out_samples 20
	config_get fail_down global consecutive_fail_down 3
	config_get recovery global recovery_success_count 5
	config_get max_rtt global max_rtt_ms 1500
	config_get_bool flush_ct global flush_conntrack 1
	# 成员进出时是否清 conntrack（仅 standard ECMP 生效；主备模式下只清新进成员）
	config_get_bool flush_switch global flush_conntrack_on_switch 1
	config_get ecmp_mode global ecmp_mode auto
	config_get route_priority global route_priority 0
	if ! is_uint "$route_priority"; then
		logger -t mwan4 "Invalid global route_priority: $route_priority"
		return 1
	fi
	# 退出时是否删预设路由。预设 0：删掉唯一预设路由会在重启窗口内让路由器失去出口，且启动失败时无法自行恢复
	config_get_bool remove_routes global remove_routes_on_exit 0

	local flush_str="false"
	[ "$flush_ct" -eq 1 ] && flush_str="true"
	local flush_switch_str="false"
	[ "$flush_switch" -eq 1 ] && flush_switch_str="true"
	# 注意：daemon 的 bool 栏位只吃 true/false，写 0/1 会让 --check-config 失败、服务直接起不来
	local remove_routes_str="false"
	[ "$remove_routes" -eq 1 ] && remove_routes_str="true"

	# 浮点栏位填成非数字（如 "10%"）会产生非法 JSON，先挡下并留明确日志（回传 1 = 不启动、不重启循环）
	local pair field value
	for pair in "loss_threshold_down:$loss_down" "degrade_loss_threshold:$degrade_loss" "degrade_hysteresis:$degrade_hysteresis" "max_rtt_ms:$max_rtt"; do
		field="${pair%%:*}"
		value="${pair#*:}"
		if ! is_decimal "$value"; then
			logger -t mwan4 "Invalid numeric value for $field: '$value' (expected e.g. 0.5)"
			return 1
		fi
	done

	for pair in "check_interval_ms:$check_interval" "probe_timeout_ms:$probe_timeout" "window_size:$window_size" "degrade_exit_samples:$degrade_exit" "consecutive_fail_down:$fail_down" "recovery_success_count:$recovery"; do
		field="${pair%%:*}"
		value="${pair#*:}"
		if ! is_uint "$value"; then
			logger -t mwan4 "Invalid integer value for $field: '$value' (expected e.g. 3)"
			return 1
		fi
	done

	local ecmp_mode_json
	case "$ecmp_mode" in
		standard|auto|resilient) ecmp_mode_json="$ecmp_mode" ;;
		*)
			logger -t mwan4 "Invalid ecmp_mode: '$ecmp_mode' (expected standard / auto / resilient)"
			return 1
			;;
	esac
	ecmp_mode_json="$(json_escape "$ecmp_mode_json")"

	# 多路径哈希策略（预设 l4；空 = 不写入、沿用系统预设 = 只有 L3 粒度）
	local hash_policy hash_policy_json="null"
	config_get hash_policy global multipath_hash_policy ""
	case "$hash_policy" in
		"") : ;;
		l3|l4|inner) hash_policy_json="\"$hash_policy\"" ;;
		*)
			logger -t mwan4 "Invalid multipath_hash_policy: '$hash_policy' (expected l3 / l4 / inner)"
			return 1
			;;
	esac

	local weight_mode weight_mode_json
	config_get weight_mode global weight_mode static
	case "$weight_mode" in
		static|quality) weight_mode_json="$weight_mode" ;;
		*)
			logger -t mwan4 "Invalid weight_mode: '$weight_mode' (expected static / quality)"
			return 1
			;;
	esac

	local dyn_interval dyn_ratio
	config_get dyn_interval global dynamic_weight_interval_ms 10000
	config_get dyn_ratio global dynamic_weight_min_ratio 0.25
	if ! is_uint "$dyn_interval"; then
		logger -t mwan4 "Invalid dynamic_weight_interval_ms: '$dyn_interval' (expected an integer)"
		return 1
	fi
	if ! is_decimal "$dyn_ratio"; then
		logger -t mwan4 "Invalid dynamic_weight_min_ratio: '$dyn_ratio' (expected e.g. 0.25)"
		return 1
	fi

	# 负载感知分流：依实测速率与每条线容量把过载线的 ECMP 权重下修、让部分 flow 转到空闲线；启用时每条 interface 都必须填 max_mbps，否则 check-config 拒绝
	# standard 下是否仍套用 quality/load_aware 动态因子（预设 0）；standard 权重变更会重算整张 multipath hash、搬走 24%~39% 既有连线却搬不动大流量，动态权重请用 resilient/auto
	local dyn_standard_ok dyn_standard_str
	config_get_bool dyn_standard_ok global allow_dynamic_weights_on_standard 0
	if [ "$dyn_standard_ok" -eq 1 ]; then dyn_standard_str="true"; else dyn_standard_str="false"; fi

	local load_aware load_aware_str
	config_get_bool load_aware global load_aware 0
	if [ "$load_aware" -eq 1 ]; then load_aware_str="true"; else load_aware_str="false"; fi
	local load_target load_recover
	config_get load_target global load_target_ratio 0.80
	config_get load_recover global load_recover_ratio 0.60
	if ! is_decimal "$load_target"; then
		logger -t mwan4 "Invalid load_target_ratio: '$load_target' (expected e.g. 0.80)"
		return 1
	fi
	if ! is_decimal "$load_recover"; then
		logger -t mwan4 "Invalid load_recover_ratio: '$load_recover' (expected e.g. 0.60)"
		return 1
	fi

	# Optional PBR addon: allow PBR-marked packets to pass through native
	# source/destination policies and reach PBR's own later fwmark rules.
	# The base package never installs, starts, or changes PBR.
	local pbr_skip_mask_json="null" pbr_mask pbr_enabled
	if [ -x /usr/libexec/mwan4-pbr-compat ] && [ -f /etc/config/pbr ] && command -v uci >/dev/null 2>&1; then
		pbr_enabled="$(uci -q get pbr.config.enabled 2>/dev/null || :)"
		if [ "$pbr_enabled" = "1" ]; then
			pbr_mask="$(uci -q get pbr.config.fw_mask 2>/dev/null || :)"
			[ -n "$pbr_mask" ] || pbr_mask="00ff0000"
			if ! printf '%s' "$pbr_mask" | grep -Eq '^[[:xdigit:]]{8}$'; then
				logger -t mwan4 "Invalid PBR fw_mask; cannot safely exclude marked flows"
				return 1
			fi
			pbr_skip_mask_json="$(printf '%d' "0x$pbr_mask" 2>/dev/null)" || return 1
			if [ "$pbr_skip_mask_json" = "0" ]; then
				logger -t mwan4 "PBR fw_mask must be nonzero"
				return 1
			fi
		fi
	fi

	# 策略分流规则（可多个 config policy 段）；字串转义、priority 验证，更细格式（CIDR）交给 daemon --check-config
	local policies_json="" policy_invalid=0
	handle_policy() {
		local section="$1"
		local p_name p_interface p_priority target_network target_device
		config_get p_name "$section" name "$section"
		config_get p_interface "$section" interface ""
		config_get p_priority "$section" priority ""
		# LuCI policies select UCI WAN sections, whereas the Rust daemon
		# expects a live kernel netdev. Preserve old raw-device values.
		config_get target_network "$p_interface" network ""
		config_get target_device "$p_interface" name "$p_interface"
		if [ -n "$target_network" ]; then
			if ! command -v network_get_device >/dev/null 2>&1 || \
			   ! network_get_device target_device "$target_network" || \
			   [ -z "$target_device" ]; then
				logger -t mwan4 "policy '$section': WAN '$p_interface' is not active; deferring rule"
				return 0
			fi
		fi
		p_interface="$target_device"
		if [ -z "$p_name" ] || [ -z "$p_interface" ]; then
			logger -t mwan4 "policy '$section': name and interface are required"
			policy_invalid=1
			return 0
		fi
		if [ -n "$p_priority" ] && ! is_uint "$p_priority"; then
			logger -t mwan4 "policy '$section': invalid priority '$p_priority' (expected an integer)"
			policy_invalid=1
			return 0
		fi

		local p_sources="" p_destinations=""
		add_policy_source() {
			[ -n "$1" ] || return 0
			local escaped
			escaped="$(json_escape "$1")"
			if [ -n "$p_sources" ]; then
				p_sources="$p_sources, \"$escaped\""
			else
				p_sources="\"$escaped\""
			fi
		}
		add_policy_destination() {
			[ -n "$1" ] || return 0
			local escaped
			escaped="$(json_escape "$1")"
			if [ -n "$p_destinations" ]; then
				p_destinations="$p_destinations, \"$escaped\""
			else
				p_destinations="\"$escaped\""
			fi
		}
		config_list_foreach "$section" source add_policy_source
		config_list_foreach "$section" destination add_policy_destination
		if [ -z "$p_sources" ]; then
			local single_sources x
			config_get single_sources "$section" source ""
			for x in $single_sources; do add_policy_source "$x"; done
		fi
		if [ -z "$p_destinations" ]; then
			local single_destinations x
			config_get single_destinations "$section" destination ""
			for x in $single_destinations; do add_policy_destination "$x"; done
		fi

		local priority_json="null"
		[ -n "$p_priority" ] && priority_json="$p_priority"
		local entry
		entry="{\"name\": \"$(json_escape "$p_name")\", \"source\": [ $p_sources ], \"destination\": [ $p_destinations ], \"interface\": \"$(json_escape "$p_interface")\", \"priority\": $priority_json}"
		if [ -n "$policies_json" ]; then
			policies_json="$policies_json, $entry"
		else
			policies_json="$entry"
		fi
	}
	config_foreach handle_policy policy
	if [ "$policy_invalid" -eq 1 ]; then
		rm -f "$CONF_FILE"
		logger -t mwan4 "Invalid policy configuration, refusing to start"
		return 1
	fi

	cat <<-EOF > "$CONF_FILE"
	{
	  "check_interval_ms": $check_interval,
	  "probe_timeout_ms": $probe_timeout,
	  "window_size": $window_size,
	  "loss_threshold_down": $loss_down,
	  "degrade_loss_threshold": $degrade_loss,
	  "degrade_hysteresis": $degrade_hysteresis,
	  "degrade_exit_samples": $degrade_exit,
	  "degrade_enter_samples": $degrade_enter,
	  "degrade_min_out_samples": $degrade_min_out,
	  "consecutive_fail_down": $fail_down,
	  "recovery_success_count": $recovery,
	  "max_rtt_ms": $max_rtt,
	  "ecmp_mode": "$ecmp_mode_json",
	  "route_priority": $route_priority,
	  "multipath_hash_policy": $hash_policy_json,
	  "weight_mode": "$weight_mode_json",
	  "dynamic_weight_interval_ms": $dyn_interval,
	  "dynamic_weight_min_ratio": $dyn_ratio,
	  "load_aware": $load_aware_str,
	  "load_target_ratio": $load_target,
	  "load_recover_ratio": $load_recover,
	  "allow_dynamic_weights_on_standard": $dyn_standard_str,
	  "policy_skip_mark_mask": $pbr_skip_mask_json,
	  "policies": [ $policies_json ],
	  "flush_conntrack_on_down": $flush_str,
	  "flush_conntrack_on_switch": $flush_switch_str,
	  "remove_routes_on_exit": $remove_routes_str,
	  "interfaces": [
	EOF

	local first=1
	local invalid_iface=0
	handle_interface() {
		local section="$1"
		local if_enabled name gateway gateway6 metric weight network_iface network_iface6 resolved_name resolved_name6
		config_get_bool if_enabled "$section" enabled 1
		[ "$if_enabled" -eq 1 ] || return 0

		# Resolve OpenWrt logical interfaces via netifd on each daemon
		# start/reload; never persist a transient PPPoE device name.
		config_get network_iface "$section" network ""
		config_get name "$section" name ""
		config_get gateway "$section" gateway ""
		config_get gateway6 "$section" gateway6 ""
		config_get network_iface6 "$section" network6 ""
		if [ -n "$network_iface" ]; then
			case "$network_iface" in
				*[!a-zA-Z0-9_.-]*)
					logger -t mwan4 "section '$section': invalid network interface name"
					invalid_iface=1
					return 0
					;;
			esac
			if ! command -v network_get_device >/dev/null 2>&1 || \
			   ! network_get_device resolved_name "$network_iface" || \
			   [ -z "$resolved_name" ] || \
			   { command -v network_is_up >/dev/null 2>&1 && ! network_is_up "$network_iface"; }; then
				# Never fall back to PPPoE's physical Ethernet carrier.
				logger -t mwan4 "section '$section': network '$network_iface' has no L3 device; waiting for netifd"
				return 0
			fi
			name="$resolved_name"
			if [ -z "$gateway" ]; then
				network_get_gateway gateway "$network_iface" 2>/dev/null || gateway=""
			fi
		fi
		# For dual-stack WANs, network6 may be a separate netifd logical
		# interface (e.g. wan6). The kernel L3 device must be identical.
		[ -n "$network_iface6" ] || network_iface6="$network_iface"
		if [ -z "$gateway6" ] && [ -n "$network_iface6" ]; then
			if command -v network_get_device >/dev/null 2>&1 && \
			   network_get_device resolved_name6 "$network_iface6" && \
			   [ "$resolved_name6" = "$name" ] && \
			   { ! command -v network_is_up >/dev/null 2>&1 || network_is_up "$network_iface6"; }; then
				network_get_gateway6 gateway6 "$network_iface6" 2>/dev/null || gateway6=""
			else
				logger -t mwan4 "section '$section': IPv6 network '$network_iface6' inactive or L3 device mismatch; IPv6 ECMP disabled on this WAN"
			fi
		fi
		if [ -z "$name" ]; then
			logger -t mwan4 "section '$section': choose 'option network' or 'option name'"
			invalid_iface=1
			return 0
		fi
		config_get metric "$section" metric 10
		config_get weight "$section" weight 1

		if ! is_uint "$metric" || ! is_uint "$weight"; then
			logger -t mwan4 "section '$section': invalid metric/weight (metric='$metric', weight='$weight')"
			invalid_iface=1
			return 0
		fi

		# 该线最大频宽（Mbps）；空 = null，进 JSON 前先验证；旧名 down_mbps 仍相容
		local max_mbps up_mbps max_json up_json
		config_get max_mbps "$section" max_mbps ""
		[ -n "$max_mbps" ] || config_get max_mbps "$section" down_mbps ""
		config_get up_mbps "$section" up_mbps ""
		max_json="null"
		up_json="null"
		if [ -n "$max_mbps" ]; then
			if ! is_decimal "$max_mbps"; then
				logger -t mwan4 "section '$section': invalid max_mbps '$max_mbps'"
				invalid_iface=1
				return 0
			fi
			max_json="$max_mbps"
		fi
		if [ -n "$up_mbps" ]; then
			if ! is_decimal "$up_mbps"; then
				logger -t mwan4 "section '$section': invalid up_mbps '$up_mbps'"
				invalid_iface=1
				return 0
			fi
			up_json="$up_mbps"
		fi

		local name_json gw_json gw6_json
		name_json="$(json_escape "$name")"
		gw_json="null"
		gw6_json="null"
		if [ -n "$gateway" ] && [ "$gateway" != "0.0.0.0" ]; then
			gw_json="\"$(json_escape "$gateway")\""
		fi
		if [ -n "$gateway6" ] && [ "$gateway6" != "::" ]; then
			# The Rust --check-config validates the IPv6 address.
			gw6_json="\"$(json_escape "$gateway6")\""
		fi

		local target_json=""
		add_target() {
			local target
			target="$(json_escape "$1")"
			if [ -n "$target_json" ]; then
				target_json="$target_json, \"$target\""
			else
				target_json="\"$target\""
			fi
		}
		config_list_foreach "$section" probe_targets add_target

		# probe_targets 写成 option 时 config_list_foreach 读不到，会静默退回预设 DNS（实测 vxlan 线因此被误判 DOWN）；两种型别都接受并留 log 提醒改用 list
		if [ -z "$target_json" ]; then
			local single_targets
			config_get single_targets "$section" probe_targets ""
			if [ -n "$single_targets" ]; then
				logger -t mwan4 "section '$section': probe_targets is a plain option; accepted, but 'list probe_targets' is preferred"
				local target
				for target in $single_targets; do
					add_target "$target"
				done
			fi
		fi

		[ -n "$target_json" ] || target_json='"223.5.5.5:53", "114.114.114.114:53"'

		# 隧道型 WAN 的 underlay 对端：封装封包目的地须走 main 表预设路由，否则有 1/N 机率自环回同隧道（实测丢包 60% 被判 DOWN）；daemon 会为对端补一条走非隧道线的 /32
		local underlay_json=""
		add_underlay() {
			[ -n "$1" ] || return 0
			local escaped
			escaped="$(json_escape "$1")"
			if [ -n "$underlay_json" ]; then
				underlay_json="$underlay_json, \"$escaped\""
			else
				underlay_json="\"$escaped\""
			fi
		}
		config_list_foreach "$section" underlay_targets add_underlay
		if [ -z "$underlay_json" ]; then
			local single_underlay
			config_get single_underlay "$section" underlay_targets ""
			if [ -n "$single_underlay" ]; then
				logger -t mwan4 "section '$section': underlay_targets is a plain option; accepted, but 'list underlay_targets' is preferred"
				for ua in $single_underlay; do
					add_underlay "$ua"
				done
			fi
		fi
		detect_underlay_targets() {
			local info
			info="$(ip -d link show "$1" 2>/dev/null)" || return 0
			case "$info" in
			*vxlan*)
				echo "$info" | sed -n 's/.*[[:space:]]remote[[:space:]]*\([0-9][0-9.]*\).*/\1/p'
				;;
			*) : ;;
			esac
		}
		if [ -z "$underlay_json" ]; then
			local ua
			for ua in $(detect_underlay_targets "$name"); do
				add_underlay "$ua"
			done
		fi

		if [ "$first" -eq 1 ]; then
			first=0
		else
			echo "    ," >> "$CONF_FILE"
		fi

		cat <<-EOF >> "$CONF_FILE"
		    {
		      "name": "$name_json",
		      "gateway": $gw_json,
		      "gateway6": $gw6_json,
		      "metric": $metric,
		      "weight": $weight,
		      "max_mbps": $max_json,
		      "up_mbps": $up_json,
		      "probe_targets": [ $target_json ],
		      "underlay_targets": [ $underlay_json ]
		    }
		EOF
	}

	config_foreach handle_interface interface

	if [ "$invalid_iface" -eq 1 ]; then
		rm -f "$CONF_FILE"
		logger -t mwan4 "Invalid interface configuration, refusing to start"
		return 1
	fi

	# 无 interface 段时不可产生 {"interfaces": []}：那会让 daemon 在 validate() 失败退出、被 procd 无限重启
	if [ "$first" -eq 1 ]; then
		rm -f "$CONF_FILE"
		logger -t mwan4 "No active configured WAN interfaces; routing left untouched"
		return 1
	fi

	cat <<-EOF >> "$CONF_FILE"
	  ]
	}
	EOF

	local pbr_mode
	config_get pbr_mode global pbr_mode standalone
	case "$pbr_mode" in
		standalone) ;;
		mossdef)
			if [ ! -f /lib/mwan4/pbr-prepare.uc ] || ! command -v ucode >/dev/null 2>&1; then
				logger -t mwan4 "mossdef PBR mode requires the optional mwan4-pbr-compat package"
				return 1
			fi
			# Private runtime state, never inherit symlinks in a shared /tmp.
			mkdir -p "$CONF_DIR/mwan4-pbr" || return 1
			chmod 700 "$CONF_DIR/mwan4-pbr" || return 1
			ucode -S -L /lib/mwan4 /lib/mwan4/pbr-prepare.uc \
				"$CONF_FILE" "$CONF_DIR/mwan4-pbr/manifest.json" "$CONF_DIR/mwan4-pbr/rules.nft" || return 1
			;;
		*) logger -t mwan4 "Unknown pbr_mode '$pbr_mode'"; return 1 ;;
	esac

	return 0
}

start_service() {
	# Query netifd's live L3 devices and gateways, especially for PPPoE.
	[ -f /lib/functions/network.sh ] && . /lib/functions/network.sh
	[ -x "$PROG" ] || {
		logger -t mwan4 "Binary $PROG not executable or not installed"
		return 1
	}

	config_load mwan4
	generate_json_config || {
		logger -t mwan4 "mwan4 is disabled or has no WAN interface configured, not starting"
		return 0
	}

	# Validate before taking a route snapshot or starting the daemon.
	if ! "$PROG" --check-config "$CONF_FILE"; then
		logger -t mwan4 "Generated config $CONF_FILE failed --check-config, aborting start"
		return 1
	fi
	# Do not hijack netifd's existing lower/equal-metric default routes.
	local configured_metric
	config_get configured_metric global route_priority 0
	if ! verify_default_route_metric "$configured_metric"; then
		return 1
	fi
	# iproute2 is required here; a failed snapshot must never silently
	# proceed to overwrite the router's only existing default gateway.
	if ! snapshot_default_routes; then
		logger -t mwan4 "Refusing to manage routes without a recovery snapshot"
		return 1
	fi

	local pbr_mode
	config_get pbr_mode global pbr_mode standalone
	if [ "$pbr_mode" = mossdef ]; then
		# nft batches are atomic. The same idempotent batch survives fw4
		# reloads before PBR's 30-pbr.nft is loaded. PBR owns its match rules.
		if ! nft -f "$CONF_DIR/mwan4-pbr/rules.nft"; then
			logger -t mwan4 "PBR adapter nft batch failed; daemon was not started"
			return 1
		fi
		mkdir -p /usr/share/nftables.d/ruleset-post || return 1
		cp "$CONF_DIR/mwan4-pbr/rules.nft" /usr/share/nftables.d/ruleset-post/25-mwan4-pbr.nft || return 1
		cp "$CONF_DIR/mwan4-pbr/manifest.json" "$CONF_DIR/mwan4-pbr.json" || return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG" -c "$CONF_FILE"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file /etc/config/mwan4
	procd_close_instance
	logger -t mwan4 "mwan4 service started with $CONF_FILE"
}

_mwan4_netifd_trigger() {
	local section="$1" network_iface network_iface6
	config_get network_iface "$section" network ""
	config_get network_iface6 "$section" network6 ""
	[ -n "$network_iface" ] && procd_add_reload_interface_trigger "$network_iface"
	[ -n "$network_iface6" ] && [ "$network_iface6" != "$network_iface" ] && \
		procd_add_reload_interface_trigger "$network_iface6"
}

service_triggers() {
	procd_add_reload_trigger "mwan4" "network" "pbr"
	config_load mwan4
	config_foreach _mwan4_netifd_trigger interface
}
